# Copy to .env and fill in real values. All vars are EXPO_PUBLIC_* — they are
# bundled into the client and are NOT secret from someone inspecting the app
# binary (the API secret below is combined with per-request signing, not
# used as a bearer credential — see src/api/client.ts).

# Backend API base URL (no trailing slash)
EXPO_PUBLIC_API_URL=https://your-backend.up.railway.app

# Must match the backend's API_CLIENT_SECRET — used to HMAC-sign every request (src/api/client.ts)
EXPO_PUBLIC_API_CLIENT_SECRET=

# Google Sign-In web client ID (OAuth 2.0 "Web application" client from Google Cloud Console)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Support contact shown in-app (Help & Support screen)
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com

# Legal pages — served by the backend itself, see backend/src/routes/legal.ts.
# Required for Play Console's Privacy Policy field and the in-app Settings links.
EXPO_PUBLIC_PRIVACY_URL=https://your-backend.up.railway.app/legal/privacy-policy
EXPO_PUBLIC_TERMS_URL=https://your-backend.up.railway.app/legal/terms
