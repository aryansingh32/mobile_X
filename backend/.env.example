NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://user:password@localhost:5432/reelflow
JWT_SECRET=replace-with-a-long-random-secret
API_CLIENT_SECRET=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Paste minified service-account JSON, or set FIREBASE_SERVICE_ACCOUNT_BASE64 instead.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id"}

REDIS_HOST=localhost
REDIS_PORT=6379
MAX_OFFERWALL_REWARD_PER_CALL=5000
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password

# Static token you put in your offerwall network's postback URL template
# (e.g. .../postback?secret=THIS_VALUE&user_id={user_id}&amount={amount}&transaction_id={transaction_id}).
# Leave unset to keep POST /api/webhooks/offerwall/postback disabled (503) until a network is wired up.
OFFERWALL_POSTBACK_SECRET=
